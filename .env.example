# Copy to .env for local use. Never commit the real file.
# Node does not load .env by itself: node --env-file=.env src/serve.js

# The Vultr Serverless Inference subscription key (Console > Products > Serverless > Inference
# > your subscription > API Key). This is not the main Vultr account API key.
# If it is empty, agent runs are refused with an error. Direct mode still works.
VULTR_INFERENCE_API_KEY=

# Defaults come from docs/competition.md section 12.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017

HOST=127.0.0.1
PORT=8080

# Labels shown in /healthz and on the page. deploy/deploy.sh writes the real ones on the VM.
# They are labels: /healthz says so, and the app does not verify them.
PADDED_CELL_DEPLOYMENT=local
PADDED_CELL_HOST=localhost
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For.
PADDED_CELL_TRUST_PROXY=0
# Canary listener: a host-side TCP counter, weak evidence. The defaults stay on loopback with a
# random port. Docker Desktop containers would reach it at host.docker.internal.
# PADDED_CELL_CANARY_BIND=127.0.0.1
# PADDED_CELL_CANARY_PORT=0
# PADDED_CELL_CANARY_TARGET_HOST=host.docker.internal
# Set to "disabled" to turn off all code execution.
# PADDED_CELL_EXECUTION=disabled
